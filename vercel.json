{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/news/cron",
      "schedule": "30 1 * * *"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{tsconfig.json,src/lib/**,src/problems/pointers.ts,node_modules/typescript/lib/*.d.ts}"
    }
  }
}
